# Installed at /opt/bgp-analyzer/etc/bgp-analyzer.env
# Copied by deploy/install.sh; edit on the host after install.

BGP_ANALYZER_BIN=/opt/bgp-analyzer/bin/bgp-analyzer
BGP_GLUE=/opt/bgp-analyzer/fixtures/glue-asns.txt
BGP_DAILY_STATE=/var/lib/bgp-analyzer
BGP_ORG_MAP_DIR=/var/lib/bgp-analyzer/org-map
BGP_ORG_MAP=/var/lib/bgp-analyzer/org-map/current
BGP_COLLECTOR=route-views2
# Freshness SLA for daily jobs (days). Weekly crawl is ~2× this, not a product requirement.
ORG_MAP_MAX_AGE_DAYS=14
BGP_ORG_MAP_RETAIN=4

STATE_CAPTURE_SOCK=/run/state/collect.sock
STATE_CAPTURE_ANNOUNCE_DIR=/var/lib/state-capture/announce

# Do NOT set BGP_ORG_MAP_OVERLAY in production (eval-only).
