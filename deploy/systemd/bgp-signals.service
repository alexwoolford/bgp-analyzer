[Unit]
Description=BGP network-contact daily signals
Documentation=file:///opt/bgp-analyzer/docs/DAILY_OPS.md
After=network-online.target
Wants=network-online.target
# Daily must not wait on the weekly org-map unit. Install enables this timer
# without --now; run-daily-signals.sh exits 0 until org_map_runs exists.

[Service]
Type=oneshot
User=bgp
Group=bgp
Nice=10
EnvironmentFile=-/opt/bgp-analyzer/etc/bgp-analyzer.env
WorkingDirectory=/opt/bgp-analyzer
ExecStart=/opt/bgp-analyzer/scripts/run-daily-signals.sh
SyslogIdentifier=bgp-signals
# State lives under /var/lib/bgp-analyzer (see EnvironmentFile).
ReadWritePaths=/var/lib/bgp-analyzer /var/lib/state-capture/announce -/run/state
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
TimeoutStartSec=2h
